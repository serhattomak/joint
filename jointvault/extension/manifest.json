{
  "manifest_version": 3,
  "name": "JointVault Collector",
  "version": "1.0.0",
  "description": "Collect X bookmarks into JointVault for review.",
  "permissions": ["activeTab", "scripting", "storage", "cookies", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:48120/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
