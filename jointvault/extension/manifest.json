{
  "manifest_version": 3,
  "name": "JointVault Collector",
  "version": "1.1.3",
  "description": "X/Instagram/YouTube listelerini aktarır, tarayıcı indirmelerini devralır, sayfa kaynaklarını bulur ve sağ tık menüsü sunar.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "alarms",
    "downloads",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:48120/*",
    "*://*/*"
  ],
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["*://*/*"]
    }
  ]
}
