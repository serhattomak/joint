{
  "manifest_version": 3,
  "name": "JointVault Collector",
  "version": "1.1.2",
  "description": "X/Instagram/YouTube listelerini aktarır, tarayıcı indirmelerini devralır, sayfa kaynaklarını bulur ve sağ tık menüsü sunar.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "alarms",
    "downloads",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:48120/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["*://*/*"]
    }
  ]
}
