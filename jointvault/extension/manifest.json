{
  "manifest_version": 3,
  "name": "JointVault Collector",
  "version": "0.1.0",
  "description": "Collect X bookmarks into JointVault for review.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:48120/*"],
  "action": {
    "default_popup": "popup.html"
  }
}
